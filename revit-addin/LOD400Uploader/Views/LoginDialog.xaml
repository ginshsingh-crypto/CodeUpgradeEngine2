<Window x:Class="LOD400Uploader.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LOD 400 - Account" 
        Height="620" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#111827">
    
    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D97706"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#4B5563"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="Button" x:Key="TabButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="Button" x:Key="TabButtonActive" BasedOn="{StaticResource TabButton}">
            <Setter Property="Foreground" Value="#F59E0B"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0">
            <TextBlock Text="LOD 400 Delivery" FontSize="24" FontWeight="Bold" Foreground="#F9FAFB"/>
            <TextBlock Text="Professional Shop Drawings Service" FontSize="14" Foreground="#9CA3AF" Margin="0,4,0,0"/>
        </StackPanel>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="SignInTab" Content="Sign In" Style="{StaticResource TabButtonActive}" Click="SignInTab_Click"/>
            <Button x:Name="RegisterTab" Content="Create Account" Style="{StaticResource TabButton}" Click="RegisterTab_Click"/>
        </StackPanel>
        
        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel x:Name="SignInPanel">
                    <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,8"/>
                    <TextBox x:Name="EmailTextBox" FontSize="14" Padding="12,10" 
                             Background="#1F2937" Foreground="White" BorderBrush="#374151" BorderThickness="1"
                             CaretBrush="White"/>
                    
                    <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,16,0,8"/>
                    <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="12,10" 
                                 Background="#1F2937" Foreground="White" BorderBrush="#374151" BorderThickness="1"
                                 CaretBrush="White"/>
                    
                    <TextBlock x:Name="ErrorText" Text="" FontSize="12" Foreground="#EF4444" Margin="0,12,0,0" 
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    
                    <TextBlock x:Name="SuccessText" Text="" FontSize="12" Foreground="#10B981" Margin="0,12,0,0" 
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
                
                <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                    <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,8"/>
                    <TextBox x:Name="RegEmailTextBox" FontSize="14" Padding="12,10" 
                             Background="#1F2937" Foreground="White" BorderBrush="#374151" BorderThickness="1"
                             CaretBrush="White"/>
                    
                    <TextBlock Text="Company Name (Optional)" FontSize="13" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,16,0,8"/>
                    <TextBox x:Name="CompanyTextBox" FontSize="14" Padding="12,10" 
                             Background="#1F2937" Foreground="White" BorderBrush="#374151" BorderThickness="1"
                             CaretBrush="White"/>
                    
                    <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,16,0,8"/>
                    <PasswordBox x:Name="RegPasswordBox" FontSize="14" Padding="12,10" 
                                 Background="#1F2937" Foreground="White" BorderBrush="#374151" BorderThickness="1"
                                 CaretBrush="White"/>
                    
                    <TextBlock Text="Confirm Password" FontSize="13" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,16,0,8"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" FontSize="14" Padding="12,10" 
                                 Background="#1F2937" Foreground="White" BorderBrush="#374151" BorderThickness="1"
                                 CaretBrush="White"/>
                    
                    <TextBlock x:Name="RegErrorText" Text="" FontSize="12" Foreground="#EF4444" Margin="0,12,0,16" 
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    
                    <TextBlock x:Name="RegSuccessText" Text="" FontSize="12" Foreground="#10B981" Margin="0,12,0,16" 
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="16,10" Background="Transparent" Foreground="#D1D5DB"
                    BorderBrush="#374151" BorderThickness="1" Margin="0,0,12,0" Click="CancelButton_Click"/>
            <Button x:Name="ActionButton" Content="Sign In" Style="{StaticResource PrimaryButton}" 
                    Click="ActionButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
